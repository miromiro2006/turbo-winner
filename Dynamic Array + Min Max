#include<stdio.h>
#include<stdlib.h>
int main(){
	int n,*p,i,max,min;
	printf("give n:");
	scanf("%d",&n);
	p=malloc(n*sizeof(int));
	for(i=0;i<n;i++){
		printf("give A[%d]",i);
		scanf("%d",&*(p+i));
	}
	max=*p;
	min=*p;
	for(i=0;i<n;i++){
		if(max<*(p+i)){
			max=*(p+i);
		}
		if(min>*(p+i)){
			min=*(p+i);
		}
	}
	printf("min:%d and max:%d",min,max);
	free(p);
}
