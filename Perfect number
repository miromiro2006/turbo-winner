#include<stdio.h>
int isPerfect(int n){
	int sum=0;
	for(int i=1;i<=n;i++){
		if(n%i==0&&i!=n){
		 sum=sum+i;
		}
	}
	if(sum==n){
		return 1;
	}else{
		return 0;
	}
}
int main(){
	int n,sum;
	printf("give n:");
	scanf("%d",&n);
	sum=isPerfect(n);
	if(sum==1){
		printf("n is perfect");
	}else{
		printf("n is not perfect");
	}
}
