#include<stdio.h>
int removeDuplicates(int *A, int n){
	int T=n;
	for(int i=0;i<n;i++){
		for(int j=i+1;j<n;j++){
			if(*(A+j)==*(A+i)){
				for(int k=j;k<n-1;k++){
					*(A+k)=*(A+k+1);
				}
				T--;
				j--;
			}
		}
	}
	return T;
}
int main(){
	int n,A[100],T;
	printf("give n:");
	scanf("%d",&n);
	for(int i=0;i<n;i++){
		printf("give A[%d]:",i);
	 scanf("%d",&A[i]);
	}
	T=removeDuplicates(A,n);
		for(int i=0;i<T;i++){
		printf("give A[%d]:%d",i,A[i]);
	}
}
