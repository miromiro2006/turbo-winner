#include<stdio.h>
#include <math.h>
int isPrime(int n){
 if (n <= 1) return 0;
 if (n == 2) return 1;
 if (n % 2 == 0) return 0;
	int limit = sqrt(n);
 for (int i = 3; i <= limit; i += 2) {
  if (n % i == 0) {
			return 0;
		}
}
return 1;
}
int main(){
	int result,n;
	printf("give n:\n");
	scanf("%d",&n);
	result=isPrime(n);
	if(result==0){
		printf("n is not prime\n");
	}
	if(result==1){
		printf("n id not prime\n");
	}
}
