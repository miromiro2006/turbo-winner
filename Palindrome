#include<stdio.h>
int isPalindrome(int n){
 int digit,reverse=0,number;
 number=n;
while(number!=0){
  digit=number%10;
  number/=10;
  reverse=reverse*10+digit;
 }
 if(n==reverse){
 	return 1;
	}else{
		return 0;
	}
}
int main(){
	int n,Palindrome;
	printf("give n:\n");
	scanf("%d",&n);
	Palindrome=isPalindrome(n);
	if(Palindrome==1){
		printf("n is Palindrome\n");
	}
	if(Palindrome==0){
		printf("n is not Palindrome");
	}
}
