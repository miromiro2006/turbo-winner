#include<stdio.h>
int sumArray(int *A, int n){
	int sum=0;
	for(int i=0;i<n;i++){
		sum+=*(A+i);
	}
	return sum;
}
int main(){
	int n,sum,A[100];
	printf("give n:");
	scanf("%d",&n);
	for(int i=0;i<n;i++){
		printf("give A[%d]:",i);
		scanf("%d",&A[i]);
	}
	sum=sumArray(A,n);
	printf("sum:%d",sum);
}
