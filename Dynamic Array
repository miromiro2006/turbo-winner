#include<stdio.h>
#include<stdlib.h>
int main(){
	int n,*p,i,x,poss;
	printf("give n:\n");
	scanf("%d",&n);
	p=malloc(n*sizeof(int));
	for(i=0;i<n;i++){
		printf("give A[%d]:\n",i);
		scanf("%d",&*(p+i));
	}
	for(i=0;i<n;i++){
		printf("A[%d]:%d\n",i,*(p+i));
	}
	printf("give x:\n");
	scanf("%d",&x);
	n++;
	p=realloc(p,sizeof(int)*n);
	*(p+n-1)=x;
	for(i=0;i<n;i++){
		printf("A[%d]:%d\n",i,*(p+i));
	}
	printf("give poss:\n");
	scanf("%d",&poss);
	for(i=poss;i<n-1;i++){
		*(p+i)=*(p+i+1);
	}
	n--;
	p=realloc(p,sizeof(int)*n);
	for(i=0;i<n;i++){
		printf("A[%d]:%d\n",i,*(p+i));
	}
	free(p);
}
