#include<stdio.h>
#include<stdlib.h>
int main(){
	int n,*p,i,poss;
	printf("give n:");
	scanf("%d",&n);
	p=malloc(n*sizeof(int));
	for(i=0;i<n;i++){
		printf("give A[%d]:",i);
		scanf("%d",&*(p+i));
	}
	do{
		printf("give poss:");
  scanf("%d",&poss);
	}while((poss<=0)||(poss>=n));
	for(i=poss;i<n-1;i++){
		*(p+i)=*(p+i+1);
	}
	n--;
	p=realloc(p,sizeof(int)*n);
	for(i=0;i<n;i++){
		printf("A[%d]:%d\n",i,*(p+i));
	}
	free(p);
}
