#include<stdio.h>
int findMin(int *A, int n){
	int min=*A;
	for(int i=0;i<n;i++){
		if(*(A+i)<min){
			min=*(A+i);
		}
	}
	return min;
}
int main(){
	int n,A[10],min;
	printf("give n:");
	scanf("%d",&n);
	for(int i=0;i<n;i++){
		printf("give A[%d]:",i);
		scanf("%d",&A[i]);
	}
	min=findMin(A,n);
	printf("min:%d",min);
}
