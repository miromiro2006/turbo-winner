#include<stdio.h>
void reverseArray(int *A, int n){
	int temp,j;
	for(int i=0;i<n/2;i++){
		j=(n-1)/2;
		temp = *(A+i);
  *(A+i) = *(A+j);
  *(A+j) = temp;
	}
}
int main(){
	int n,A[100];
	printf("give n:");
	scanf("%d",&n);
	for(int i=0;i<n;i++){
		printf("give A[%d]",i);
		scanf("%d",&A[i]);
	}
	reverseArray(A,n);
	for(int i=0;i<n;i++){
		printf("A[%d]:%d",i,A[i]);
	}
}
